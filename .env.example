# Public env (safe to commit)
NEXT_PUBLIC_STORE_NAME=Vibrella
NEXT_PUBLIC_STORE_EMAIL=shop.vibrella@gmail.com
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳

# --- Server-only secrets. NEVER commit real values. Set in Vercel Dashboard > Settings > Environment Variables. ---
# Admin login email (must match the email you use to log in at /admin/login)
ADMIN_EMAIL=
# bcrypt hash of the admin password. Generate it locally, never paste the plain password here.
# Run: npm run hash  (then paste ONLY the hash output below / into Vercel)
ADMIN_PASSWORD_HASH=
# Random secret for signing the admin session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: Postgres / Supabase connection string for production.
# If empty, Phase 1 uses the JSON files in /data (local dev / demo). On Vercel, set DATABASE_URL to enable persistent storage.
DATABASE_URL=

# Optional (Phase 3 AI Accountant): leave empty to use the built-in offline rules.
# Set these ONLY if you want the optional hosted-AI hook (lib/ai-accountant.ts askExternalAI).
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
